// TAPS content data model (TAPS-2.1). Field list matches
// docs/project-knowledge/05-ARCHITECTURE.md §4 "Core Data Model" for the six
// content models owned by EPIC 2 (ExamBoard, Post, Syllabus, PastPaper,
// StudyMaterial, Book). `createdAt`/`updatedAt` audit timestamps are added to
// every model beyond what §4 lists — see docs/adr/003-content-schema-design.md
// for that and the other schema decisions (id strategy, delete behavior,
// indexing) made while translating the architecture doc into a real schema.
//
// QuizQuestion, QuizAttempt, StudyPlan from the same §4 list belong to
// EPIC 4/5/7/8 and are intentionally out of scope for this sprint (see
// docs/architecture/data-model.md). `User` was added by TAPS-5.1 — see the
// model below and docs/adr/014-user-auth-separate-from-admin-auth.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExamBoardType {
  TEACHING
  TET
}

enum PostType {
  NOTIFICATION
  ARTICLE
}

// PastPaper text-extraction pipeline state (TAPS-4.0) — see
// docs/adr/010-pdf-text-extraction.md. PENDING is the default a row is
// created with; the ingestion service moves it to DONE (extractedText set)
// or FAILED (extractedText left null) and never leaves it at PENDING once
// ingestion has actually run.
enum ExtractionStatus {
  PENDING
  DONE
  FAILED
}

// QuizQuestion difficulty, assigned by AIService.generateQuizFromPaper's
// model output (TAPS-4.1) — see docs/adr/011-ai-quiz-generation.md.
enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
}

// Which provider actually generated a QuizQuestion row (TAPS-4.2) — ANTHROPIC
// unless Anthropic failed in a fallback-eligible way and OpenAI produced the
// result instead. See docs/adr/012-ai-provider-fallback.md.
enum AIProvider {
  ANTHROPIC
  OPENAI
}

model ExamBoard {
  id          String        @id @default(cuid())
  // @unique added in TAPS-2.4: the seed script needs to upsert idempotently
  // by name (Prisma's `upsert` only accepts unique/id fields in `where`),
  // and two exam boards sharing a name would be a genuine data-integrity
  // bug regardless of seeding — see docs/architecture/data-model.md.
  name        String        @unique
  type        ExamBoardType
  description String        @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  posts      Post[]
  syllabuses Syllabus[]
  pastPapers PastPaper[]

  // Generated column (name + description), populated by Postgres itself —
  // Prisma can't model tsvector natively, so this is declared Unsupported
  // (present so schema.prisma accurately describes the real DB shape and
  // future migrations don't try to drop it) and only ever queried via raw
  // SQL. See TAPS-3.4 / docs/adr/009-full-text-search.md.
  searchVector Unsupported("tsvector")?

  @@map("exam_boards")
}

model Post {
  id          String     @id @default(cuid())
  examBoardId String?
  examBoard   ExamBoard? @relation(fields: [examBoardId], references: [id], onDelete: SetNull)
  type        PostType
  // Free-form, nullable classification (TAPS-3.8) — e.g. "exam-pattern",
  // "eligibility" — so apps/web's per-board sub-pages can filter to
  // genuinely distinct content instead of all sharing the same
  // ARTICLE-typed list. Deliberately a plain String, not an enum: the set
  // of categories is expected to grow as more sub-pages/content types are
  // added, and a String lets admins introduce a new category by simply
  // tagging a post with it, without a schema migration for every addition.
  // See docs/adr/013-post-category-field.md.
  category    String?
  title       String
  slug        String     @unique
  body        String     @db.Text
  heroImage   String?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Generated column (title + body) — see the same note on ExamBoard above.
  searchVector Unsupported("tsvector")?

  // slug's uniqueness above already indexes it; examBoardId is indexed
  // separately since it's an optional FK many posts will filter/join on.
  // category is indexed too, now that the public API filters on it.
  @@index([examBoardId])
  @@index([category])
  @@map("posts")
}

model Syllabus {
  id          String    @id @default(cuid())
  examBoardId String
  examBoard   ExamBoard @relation(fields: [examBoardId], references: [id], onDelete: Restrict)
  subject     String
  topics      String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([examBoardId])
  @@index([subject])
  @@map("syllabuses")
}

model PastPaper {
  id          String    @id @default(cuid())
  examBoardId String
  examBoard   ExamBoard @relation(fields: [examBoardId], references: [id], onDelete: Restrict)
  subject     String
  year        Int
  fileUrl     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // TAPS-4.0: text extracted from `fileUrl`'s PDF by
  // PastPaperIngestionService, for EPIC 4's quiz generation to consume.
  // Null until extraction has run and succeeded; stays null on FAILED too
  // (a failed extraction never leaves stale/partial text behind).
  extractedText    String?          @db.Text
  extractionStatus ExtractionStatus @default(PENDING)

  quizQuestions QuizQuestion[]

  @@index([examBoardId])
  @@index([subject])
  @@index([year])
  // Composite index for the natural admin/user browse pattern (a board's
  // papers filtered by subject and year together) — see the ADR.
  @@index([examBoardId, subject, year])
  @@map("past_papers")
}

// AI-generated question bank (TAPS-4.1) — populated by
// AIService.generateQuizFromPaper from a PastPaper's extractedText. See
// docs/adr/011-ai-quiz-generation.md and 05-ARCHITECTURE.md §5. Every row
// starts aiGenerated: true, reviewedByAdmin: false per 08-AI-FEATURES-SPEC.md
// §5's guardrail — an AI-written question is never presented as
// admin-reviewed until an admin actually reviews it.
model QuizQuestion {
  id              String         @id @default(cuid())
  pastPaperId     String
  pastPaper       PastPaper      @relation(fields: [pastPaperId], references: [id], onDelete: Restrict)
  subject         String
  topic           String
  difficulty      QuizDifficulty
  questionText    String         @db.Text
  options         String[]
  correctOption   Int
  explanation     String         @db.Text
  aiGenerated     Boolean        @default(true)
  reviewedByAdmin Boolean        @default(false)
  // Which provider produced this row (TAPS-4.2) — ANTHROPIC is the default
  // path; OPENAI only when Anthropic failed in a fallback-eligible way (see
  // docs/adr/012-ai-provider-fallback.md). Defaulted rather than required-
  // with-no-default so existing rows from before this column existed
  // backfill cleanly.
  aiProvider      AIProvider     @default(ANTHROPIC)
  createdAt       DateTime       @default(now())

  @@index([pastPaperId])
  @@index([subject])
  @@index([topic])
  @@map("quiz_questions")
}

model StudyMaterial {
  id        String   @id @default(cuid())
  subject   String
  title     String
  fileUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No examBoardId per 05-ARCHITECTURE.md §4 — study material is organized
  // by subject only, not tied to a specific exam board.
  @@index([subject])
  @@map("study_materials")
}

model Book {
  id        String   @id @default(cuid())
  class     String
  subject   String
  title     String
  fileUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subject])
  @@index([class])
  @@map("books")
}

// End-user accounts (TAPS-5.1) — a deliberately separate identity from the
// single shared admin credential in AuthService/ADMIN_PASSWORD_HASH (see
// docs/adr/005-admin-auth-and-validation.md and, for why the two are never
// merged, docs/adr/014-user-auth-separate-from-admin-auth.md). Consumed by
// apps/api/src/user-auth/, not apps/api/src/auth/.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  // Exam board names/IDs the user is preparing for — a free-form String[]
  // per 05-ARCHITECTURE.md §4's original description, not an FK relation to
  // ExamBoard. TAPS-5.1's scope is auth only; whichever future story builds
  // the progress dashboard decides how this list is populated/validated.
  examTargets  String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

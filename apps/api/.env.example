# Copy to .env and fill in real values locally. Never commit .env — see
# docs/project-knowledge/06-CODING-STANDARDS.md "Environment & Secrets".
# In deployed environments (Fly.io), set these as secrets, not plain env vars.

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/taps

# Anthropic API key for the AIService boundary (see 05-ARCHITECTURE.md §5).
ANTHROPIC_API_KEY=sk-ant-placeholder

# Port the NestJS server listens on. Falls back to 8080 if unset (see main.ts).
PORT=8080

# Origin allowed to make cross-origin requests (the web app). Falls back to
# the Next.js dev default (http://localhost:3000) if unset (see main.ts).
ALLOWED_ORIGIN=http://localhost:3000

# Signs/verifies the admin JWT (see docs/adr/005-admin-auth-and-validation.md
# and docs/api/auth.md). Any long random string; e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# bcrypt hash of the single admin password (never the plaintext — see the
# same ADR). Generate with:
#   node -e "require('bcryptjs').hash(process.argv[1], 10).then(console.log)" 'your-chosen-password'
ADMIN_PASSWORD_HASH=$2b$10$replace.with.a.real.bcrypt.hash.................

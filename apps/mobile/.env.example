# Copy to .env.local and fill in real values locally. Never commit
# .env/.env.local — see docs/project-knowledge/06-CODING-STANDARDS.md
# "Environment & Secrets". Expo's own convention is .env.local for
# untracked local overrides (already covered by the root .gitignore's
# .env.* pattern).

# Base URL of apps/api's public content API (docs/api/public-content.md).
# EXPO_PUBLIC_ prefix (Expo's client-env convention, equivalent to Next's
# NEXT_PUBLIC_ used by apps/web/.env.example) — inlined into the app bundle
# at build time, not a secret. Falls back to the Android emulator's loopback
# alias for the host machine's apps/api dev server if unset (see
# src/lib/api.ts) — NOT localhost, which inside the emulator resolves to the
# emulator itself. In production this is the deployed Fly URL — see
# docs/runbooks/deploy-api.md.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

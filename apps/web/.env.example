# Copy to .env.local and fill in real values locally. Never commit
# .env/.env.local — see docs/project-knowledge/06-CODING-STANDARDS.md
# "Environment & Secrets". Next.js's own convention is .env.local for
# untracked local overrides (already covered by the root .gitignore's
# .env.* pattern).

# Base URL of apps/api's public content API (docs/api/public-content.md).
# NEXT_PUBLIC_ prefix because the client-side search box (TAPS-3.4) calls
# this directly from the browser — it's a public base URL, not a secret.
# Falls back to the apps/api dev default if unset (see lib/api.ts).
# In production this is the deployed Fly URL — see docs/runbooks/deploy-api.md.
NEXT_PUBLIC_API_URL=http://localhost:8080

# TAPS-3.7 (docs/adr/019-tag-based-cache-revalidation.md): shared secret
# authenticating apps/api's server-to-server calls to this app's own
# POST /api/revalidate. Must match apps/api's REVALIDATION_SECRET exactly
# (see apps/api/.env.example). NOT NEXT_PUBLIC_ — this one IS a secret; if
# unset, /api/revalidate 500s on every call rather than silently accepting
# an unauthenticated revalidation request. Any long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATION_SECRET=replace-with-a-long-random-string
